{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.video-skill-pack/schemas/edit-plan.schema.json",
  "title": "Video Edit Plan",
  "type": "object",
  "required": ["schemaVersion", "sourceId", "timebase", "timeline", "cuts", "captions", "overlays", "zooms", "broll", "music", "soundEffects", "deliverables", "warnings"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "sourceId": {"type": "string", "minLength": 1},
    "timebase": {
      "type": "object",
      "required": ["unit", "fps"],
      "properties": {
        "unit": {"const": "seconds"},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": ["duration"],
      "properties": {"duration": {"type": "number", "minimum": 0}},
      "additionalProperties": true
    },
    "cuts": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "captions": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "overlays": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "zooms": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "reframes": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "broll": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "music": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "soundEffects": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "deliverables": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["id", "start", "end", "source", "reason", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "source": {"type": "string"},
        "reason": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
